# Database Configuration
# Example (PostgreSQL): Host=localhost;Port=5432;Database=book2screen;Username=postgres;Password=your_password
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=book2screen;Username=postgres;Password=your_password

# JWT Authentication
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_ISSUER=Book2Screen
JWT_AUDIENCE=Book2ScreenUsers
JWT_EXPIRY_MINUTES=60

# API Configuration (Accessible from browser)
# NOTE: Use https:// in staging/production environments
API_URL_EXTERNAL=http://localhost:5000

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=noreply@book2screen.com
# Use a Gmail App Password (16 characters), not your account password
# Guide: https://support.google.com/accounts/answer/185833
SENDER_PASSWORD=your-gmail-app-password-16-chars
SENDER_NAME=Book2Screen
